# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/dist

# misc
.DS_Store
*.pem
*.local

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# claude code (per-user settings; the shared .claude/ config can still be committed)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
